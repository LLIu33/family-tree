# syntax=docker/dockerfile:1
# Lean API image for Render Free (no Vite build — use static site separately).

FROM node:22-bookworm-slim AS api-build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY nest-cli.json tsconfig.json tsconfig.build.json ./
COPY src ./src
RUN npm run build && npm prune --omit=dev

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV SERVE_WEB=false
ENV PORT=3000
ENV SWAGGER_ENABLED=false

COPY package.json package-lock.json ./
COPY --from=api-build /app/node_modules ./node_modules
COPY --from=api-build /app/dist ./dist

EXPOSE 3000
# Pass heap flag on argv — Render may override/ignore NODE_OPTIONS.
# ~460 leaves a little headroom under Free's ~512MB cgroup.
CMD ["node", "--max-old-space-size=460", "--optimize-for-size", "dist/main.js"]
