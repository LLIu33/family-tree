# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api
JWT_SECRET=dev-family-tree-secret-change-me
JWT_EXPIRES_IN=7d
APP_PUBLIC_URL=http://localhost:5173
MAIL_DRIVER=log
PASSWORD_RESET_TTL_MS=3600000
# Auth rate limits (per IP, in-memory; window AUTH_THROTTLE_TTL in ms)
AUTH_THROTTLE_TTL=60000
AUTH_THROTTLE_LIMIT_LOGIN=5
AUTH_THROTTLE_LIMIT_REGISTER=3
AUTH_THROTTLE_LIMIT_FORGOT=3
AUTH_THROTTLE_LIMIT_RESET=5
# Serve Vite build from API (Docker prod / Oracle). On Render API set false.
SERVE_WEB=false

# Neo4j — local / Docker Compose
NEO4J_SCHEME=bolt
NEO4J_HOST=localhost
NEO4J_PORT=7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_password
NEO4J_DATABASE=neo4j
# Aura Free: prefer a single URI (overrides scheme/host/port when set)
# NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io

# Storage (avatars require S3-compatible storage; STORAGE_TYPE=local is not implemented)
STORAGE_TYPE=s3
STORAGE_LOCAL_PATH=./uploads
STORAGE_SERVE_ROOT=/uploads
STORAGE_MAX_FILE_SIZE_MB=20
STORAGE_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf
STORAGE_GENERATE_THUMBNAILS=true

# Swagger
SWAGGER_ENABLED=true
SWAGGER_TITLE="Древо API"
SWAGGER_PATH=api-docs

# S3-compatible storage (AWS S3, Yandex Object Storage, …)
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name
# Optional API endpoint (required for Yandex / MinIO / R2). Must include https://
# AWS_S3_ENDPOINT=https://storage.yandexcloud.net
# Public base for object URLs in DB (no trailing slash). Use real bucket name.
# Empty → https://<bucket>.s3.amazonaws.com
# AWS_S3_PUBLIC_URL_BASE=https://storage.yandexcloud.net/your-bucket-name
# Path-style addressing (auto-true when AWS_S3_ENDPOINT is set):
# AWS_S3_FORCE_PATH_STYLE=true
#
# Yandex Object Storage:
# AWS_REGION=ru-central1
# AWS_S3_ENDPOINT=https://storage.yandexcloud.net
# AWS_S3_PUBLIC_URL_BASE=https://storage.yandexcloud.net/your-bucket-name
# AWS_S3_FORCE_PATH_STYLE=true


# File upload settings
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=image/*,application/pdf,audio/*,video/*
