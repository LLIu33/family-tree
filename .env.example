# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api

# Neo4j
NEO4J_SCHEME=bolt
NEO4J_HOST=localhost
NEO4J_PORT=7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_password
NEO4J_DATABASE=neo4j


# Общие настройки хранилища
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_SERVE_ROOT=/uploads
STORAGE_MAX_FILE_SIZE_MB=20
STORAGE_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf
STORAGE_GENERATE_THUMBNAILS=true

# Swagger
SWAGGER_ENABLED=true
SWAGGER_TITLE=Family Tree API
SWAGGER_PATH=api-docs

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name

# File upload settings
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=image/*,application/pdf,audio/*,video/*