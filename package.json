{
  "name": "rodnik",
  "version": "1.0.0",
  "description": "Древо — система управления семейным древом (NestJS + Neo4j)",
  "author": "Grechko Artem",
  "license": "MIT",
  "scripts": {
    "start": "node --max-old-space-size=460 --optimize-for-size dist/main.js",
    "start:dev": "nest start --watch",
    "start:nest": "nest start",
    "build": "nest build",
    "build:web": "npm ci --prefix web && npm run build --prefix web",
    "build:render": "npm run build && npm run build:web && node scripts/copy-web-public.mjs",
    "test": "jest",
    "test:cov": "jest --coverage",
    "lint": "eslint \"src/**/*.{ts,js}\" && tsc --noEmit",
    "lint:eslint": "eslint \"src/**/*.{ts,js}\"",
    "typecheck": "tsc --noEmit"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "**/*.{ts,js}",
      "!**/*.module.ts",
      "!**/*.interface.ts",
      "!**/main.ts",
      "!**/*.dto.ts",
      "!**/index.ts"
    ],
    "coverageDirectory": "../coverage",
    "coverageReporters": ["text", "text-summary", "lcov"]
  },
  "dependencies": {
    "@nestjs/common": "^11.0.20",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.20",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.20",
    "@nestjs/swagger": "^11.1.4",
    "aws-sdk": "^2.1692.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "gedcom-typescript": "^0.1.0",
    "neo4j-driver": "^5.28.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.1",
    "uuid": "^11.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/family-tree-app.git"
  },
  "keywords": [
    "family tree",
    "genealogy"
  ],
  "bugs": {
    "url": "https://github.com/your-username/family-tree-app/issues"
  },
  "homepage": "https://github.com/your-username/family-tree-app#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^28.1.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.14.1",
    "@types/passport-jwt": "^4.0.1",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "jest": "^28.1.0",
    "supertest": "^6.2.0",
    "ts-jest": "^28.0.2",
    "ts-node": "^10.8.0",
    "typescript": "~5.7.0",
    "typescript-eslint": "^8.67.0"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true
  }
}
